#!/bin/bash
# Holds a Rex pane for a RexWeb browser panel. RexWeb draws a native WebKit
# view over this pane's body; this process keeps the pane alive, re-registers
# the panel if RexWeb restarts, and closes the panel when the pane goes away.
set -u

# This script is a pane's own program. Run by hand, or by an agent's shell
# tool, it would turn the caller's pane into a browser pane and cover it, so
# it refuses an option-like argument and any output that isn't a terminal.
case "${1:-}" in -*) by_hand=1 ;; *) by_hand=0 ;; esac
[ -t 1 ] || by_hand=1
if [ "$by_hand" = 1 ]; then
  echo "rexweb-pane holds a Rex pane for a browser and isn't run by hand. Use: rexweb open [URL]" >&2
  exit 2
fi
PATH="$PATH:/usr/bin:/opt/homebrew/bin:/usr/local/bin"
url="${1:-}"
cfg="$HOME/.rexweb/config.json"
engine="${REXWEB_ENGINE:-$(jq -r '.engine // "webkit"' "$cfg" 2>/dev/null || echo webkit)}"
appname="RexWeb"
if [ "$engine" = chromium ]; then
  appname="RexWebChromium"
  port="${REXWEB_PORT:-$(jq -r '.chromium_port // 18803' "$cfg" 2>/dev/null || echo 18803)}"
else
  port="${REXWEB_PORT:-$(jq -r '.port // 18802' "$cfg" 2>/dev/null || echo 18802)}"
fi
id="${REX_BLOCK:?rexweb-pane must run inside a Rex pane}"
session="${REX_SESSION:?rexweb-pane must run inside a Rex pane}"
focus="${REXWEB_FOCUS:-false}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

command -v jq >/dev/null 2>&1 || { printf '  rexweb needs jq. Install it with: brew install jq\n'; sleep 3600; exit 1; }

post() {
  # The token header goes in on standard input, so `ps` never shows it.
  printf 'x-rexweb-token: %s\n' "$(cat "$HOME/.rexweb/token" 2>/dev/null)" |
    curl -s -m "${3:-3}" -X POST "http://127.0.0.1:$port$1" -H 'content-type: application/json' -H @- -d "$2"
}

shown=""
show() {
  [ "$1" = "$shown" ] && return
  shown="$1"
  printf '\033[?25l\033[2J\033[H\033[2m  %s\033[0m\n' "$1"
}

app_path() {
  if [ -n "${REXWEB_APP:-}" ]; then echo "$REXWEB_APP"; return; fi
  case "$here" in */Contents/Resources)
    local beside; beside="$(dirname "${here%/Contents/Resources}")/${appname}.app"
    [ -d "$beside" ] && { echo "$beside"; return; } ;;
  esac
  for a in "$HOME/Applications/${appname}.app" "/Applications/${appname}.app"; do
    [ -d "$a" ] && { echo "$a"; return; }
  done
}

ensure_app() {
  post /health '{}' 1 >/dev/null && return 0
  local app; app="$(app_path)"
  [ -n "$app" ] || return 2
  show "rexweb · starting ${appname}…"
  open -g "$app"
  for _ in $(seq 1 50); do post /health '{}' 1 >/dev/null && return 0; sleep 0.1; done
  show "rexweb · ${appname} didn't start. Run: rexweb doctor"
  return 1
}

register() {
  local out
  out="$(post /register "$(jq -nc --arg id "$id" --arg s "$session" --arg u "$url" --argjson f "$focus" \
    '{id:$id, session:$s, url:$u, focus:$f}')")"
  if jq -e '.id' >/dev/null 2>&1 <<<"$out"; then
    show "rexweb · ${url:-blank}"
  else
    show "rexweb · couldn't register: $(jq -r '.error // "no answer"' <<<"$out" 2>/dev/null). Run: rexweb doctor"
  fi
}

connect() {
  ensure_app
  case $? in
    0) register ;;
    2) show "rexweb · ${appname}.app isn't installed. Close this pane, or run ./install.sh"; missing=$((missing + 1)) ;;
  esac
}

cleanup() { post /close "$(jq -nc --arg id "$id" '{id:$id}')" 1 >/dev/null; exit 0; }
trap cleanup EXIT HUP INT TERM

missing=0
show "rexweb · ${url:-blank}"
connect
focus=false

while [ "$missing" -lt 30 ]; do
  sleep 2 & wait $!
  info="$(post /info "$(jq -nc --arg id "$id" '{id:$id}')" 2)"
  if cur="$(jq -er '.url // empty' <<<"$info" 2>/dev/null)"; then
    url="$cur"; missing=0
    show "rexweb · $url"
  elif ! jq -e '.id' <<<"$info" >/dev/null 2>&1; then
    connect
  fi
done
